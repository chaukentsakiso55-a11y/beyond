ct(self.arena_done);self.pool.start(worker)
    def arena_done(self,rows):
        self.arena_winner.clear();self.arena_winner.addItems([r.get('provider','') for r in rows if r.get('ok')]);html=[]
        for r in rows:html.append(f"<h3>{r.get('provider')} · {r.get('model')} · {r.get('latency',0):.2f}s</h3><div>{(r.get('text') or '').replace('&','&amp;').replace('<','&lt;').replace('>','&gt;').replace(chr(10),'<br>')}</div><hr>")
        self.arena_out.setHtml(''.join(html))

    def mark_winner(self):
        name=self.arena_winner.currentText()
        if name:self.core.router.record_arena_feedback(name,1.0);QMessageBox.information(self,'Model Arena',f'{name} received a positive task-quality vote and will gain a small routing preference over time.')

