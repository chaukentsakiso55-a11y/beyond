        bar=QHBoxLayout();refresh=QPushButton('Refresh Registry');refresh.clicked.connect(self.refresh);self.need=QLineEdit();self.need.setPlaceholderText('Required capabilities, comma-separated');choose=QPushButton('Choose Device');choose.clicked.connect(self.choose);self.result=QLabel();self.result.setStyleSheet('color:#7896aa');bar.addWidget(refresh);bar.addWidget(self.need,1);bar.addWidget(choose);bar.addWidget(self.result);rl.addLayout(bar)
        self.table=QTableWidget(0,6);self.table.setHorizontalHeaderLabels(['Device','Platform','Capabilities','Trusted','Online','Last Seen']);self.table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch);rl.addWidget(self.table);lay.addWidget(registry,1);self.refresh()

    def _allow_discovery(self):
        permission='network.discovery';d=self.core.security.decision(permission)
        if d=='allow':return True
        if d=='deny':QMessageBox.warning(self,'Network Discovery','Network discovery is denied in Security Center.');return False
        msg='Allow nearby-device discovery for this Infinity session?\n\nUse this only on a network you own or have permission to scan. Infinity will not scan ports, test passwords, or probe public Internet addresses.'
        if QMessageBox.question(self,'Network Discovery Permission',msg)==QMessageBox.Yes:
            self.core.security.grant_session(permission);return True
        return False

    def scan_lan(self):
        if not self._allow_discovery():return
        self.scan_status.setText('Scanning private LAN…');w=Worker(self.core.network.discover_lan,True);w.signals.result.connect(self.show_discovery);w.signals.error.connect(lambda e:self.scan_status.setText('Scan failed: '+e));self.pool.start(w)

