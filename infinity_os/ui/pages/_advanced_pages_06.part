date_repo.text().strip();(ROOT/'config'/'update.json').write_text(json.dumps({'github_repo':repo},indent=2),encoding='utf-8');self.core.updater.repo=repo;self.update_out.setPlainText('Update repository saved: '+repo)
    def check_update(self):
        self.update_out.setPlainText('Checking…');worker=Worker(self.core.updater.check);worker.signals.result.connect(lambda r:self.update_out.setPlainText(json.dumps(r,indent=2)));worker.signals.error.connect(lambda e:self.update_out.setPlainText('Update check failed: '+e));self.pool.start(worker)
    def backup(self):self.update_out.setPlainText('Backup created: '+self.core.updater.backup())
    def rollback(self):
        path=self.core.updater.latest_backup()
        if not path:self.update_out.setPlainText('No Infinity backup exists yet.');return
        if QMessageBox.question(self,'Rollback Infinity',f'Restore the latest backup?\n\n{path}\n\nInfinity should be restarted afterward.')==QMessageBox.Yes:self.core.updater.rollback(path);self.update_out.setPlainText('Rollback restored: '+path+'\nRestart Infinity OS.')
    def safe(self):
        if self.core.diagnostics.safe_mode():self.core.diagnostics.disable_safe_mode()
        else:self.core.diagnostics.enable_safe_mode()
        self.update_out.setPlainText('Safe Mode: '+str(self.core.diagnostics.safe_mode()))

class MeshPage(QWidget):
    def __init__(self,core):
        super().__init__();self.core=core;self.pool=QThreadPool.globalInstance();lay=QVBoxLayout(self)
        lay.addWidget(SectionHeader('Infinity Device Mesh','Registry plus safe local discovery for devices on your private LAN and present/known Bluetooth devices. Discovery does not scan ports or test credentials.'))

        discover=Card();dl=QVBoxLayout(discover);title=QLabel('NEARBY DEVICE DISCOVERY');title.setStyleSheet('font-weight:800;color:#46e6ff');dl.addWidget(title)
        row=QHBoxLayout();lan=QPushButton('Scan Same Network');lan.setObjectName('Primary');lan.clicked.connect(self.scan_lan);bt=QPushButton('Nearby Bluetooth');bt.clicked.connect(self.scan_bluetooth);clear=QPushButton('Clear Results');clear.clicked.connect(self.clear_discovery);self.scan_status=QLabel('Ready');self.scan_status.setStyleSheet('color:#7896aa');row.addWidget(lan);row.addWidget(bt);row.addWidget(clear);row.addWidget(self.scan_status,1);dl.addLayout(row)
        note=QLabel('Only scan a network you own or have permission to use. Infinity limits active LAN discovery to private IPv4 addresses on the network this PC is already connected to.');note.setWordWrap(True);note.setStyleSheet('color:#7896aa;font-size:11px');dl.addWidget(note)
        self.discovery_table=QTableWidget(0,7);self.discovery_table.setHorizontalHeaderLabels(['Type','Device','IP','MAC','Interface','State','Source']);self.discovery_table.horizontalHeader().setSectionResizeMode(QHeaderView.Stretch);dl.addWidget(self.discovery_table);lay.addWidget(discover,2)

