    def choose_project(self):
        p=QFileDialog.getExistingDirectory(self,'Open project');
        if p:self.project=Path(p);self.path.setText(p);self.load_tree()
    def load_tree(self):
        self.tree.clear();
        if not self.project:return
        root=QTreeWidgetItem([self.project.name]);root.setData(0,Qt.UserRole,str(self.project));root.setData(0,Qt.UserRole+1,True);self.tree.addTopLevelItem(root);nodes={'':root}
        for item in self.core.forge.tree(self.project):
            rel=item['path'];parent=str(Path(rel).parent).replace('\\','/');parent='' if parent=='.' else parent;par=nodes.get(parent,root);node=QTreeWidgetItem([Path(rel).name]);node.setData(0,Qt.UserRole,str(self.project/rel));node.setData(0,Qt.UserRole+1,item['dir']);par.addChild(node)
            if item['dir']:nodes[rel.replace('\\','/')]=node
        root.setExpanded(True)
    def open_tree_item(self,item):
        if item.data(0,Qt.UserRole+1):return
        p=Path(item.data(0,Qt.UserRole));
        if p.stat().st_size>2*1024*1024:return
        self.current_file=p
        for i in range(self.editor_tabs.count()):
            if self.editor_tabs.widget(i).property('file_path')==str(p):self.editor_tabs.setCurrentIndex(i);return
        editor=QPlainTextEdit();editor.setLineWrapMode(QPlainTextEdit.NoWrap);editor.setPlainText(self.core.forge.read(p));editor.setProperty('file_path',str(p));idx=self.editor_tabs.addTab(editor,p.name);self.editor_tabs.setTabToolTip(idx,str(p));self.editor_tabs.setCurrentIndex(idx)
    def save_file(self):
        editor=self.editor_tabs.currentWidget()
        if not editor:return
        current=Path(editor.property('file_path'))
        if self.core.security.decision('files.write')=='deny':QMessageBox.warning(self,'Forge','files.write is denied.');return
        if self.core.security.decision('files.write')=='ask' and QMessageBox.question(self,'Permission','Allow Forge to write this file?')!=QMessageBox.Yes:return
        try:self.core.forge.write(self.project,current,editor.toPlainText());self.core.security.audit('forge.write',{'file':str(current)});QMessageBox.information(self,'Forge','Saved.')
