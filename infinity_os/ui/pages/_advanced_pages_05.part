    def voice_tab(self):
        w=QWidget();f=QFormLayout(w);self.wake=QCheckBox('Enable wake-word listener');self.wake.setChecked(self.core.voice.config.get('enabled',False));self.words=QLineEdit(', '.join(self.core.voice.config.get('wakewords',[])));save=QPushButton('Save Voice Settings');save.clicked.connect(self.save_voice);test=QPushButton('Test Voice Output');test.clicked.connect(lambda:self.core.voice.speak('AEGIS voice output is online.'));f.addRow(self.wake);f.addRow('Wake words',self.words);f.addRow(save);f.addRow(test);return w
    def save_voice(self):self.core.voice.config['enabled']=self.wake.isChecked();self.core.voice.config['wakewords']=[x.strip().lower() for x in self.words.text().split(',') if x.strip()];self.core.voice.save();QMessageBox.information(self,'Voice','Voice settings saved. Restart Infinity to start wake listening automatically.')
