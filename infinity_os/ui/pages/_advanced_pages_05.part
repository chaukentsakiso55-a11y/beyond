ery')
    def appearance_tab(self):
        w=QWidget();f=QFormLayout(w);st=self.core.appearance.settings;pal=self.core.appearance.palette();self.preset=QComboBox();self.preset.addItems(PRESETS.keys());self.preset.setCurrentText(st.get('preset','Infinity Neon'));self.color_buttons={}
        for key,label,default in [('accent','Accent',pal['accent']),('background','Background',pal['bg']),('panel','Sidebar / panel',pal['panel']),('card','Cards',pal['card'])]:
            b=QPushButton(st.get(key) or 'Use preset '+label.lower());b.clicked.connect(lambda _,k=key,d=default:self.choose_color(k,d));self.color_buttons[key]=b
        self.density=QComboBox();self.density.addItems(['compact','comfortable','spacious']);self.density.setCurrentText(st.get('density','comfortable'));self.sidebar=QComboBox();self.sidebar.addItems(['compact','standard','wide']);self.sidebar.setCurrentText(st.get('sidebar','standard'));self.scale=QComboBox();self.scale.addItems(['0.85','0.95','1.0','1.1','1.2','1.3']);self.scale.setCurrentText(str(st.get('font_scale',1.0)));self.effects=QComboBox();self.effects.addItems(['minimal','glass','glow']);self.effects.setCurrentText(st.get('effects','glass'));apply=QPushButton('Apply Appearance');apply.setObjectName('Primary');apply.clicked.connect(self.apply_appearance);f.addRow('Theme preset',self.preset)
        for key,label in [('accent','Custom accent'),('background','Custom background'),('panel','Custom sidebar / panel'),('card','Custom card color')]:f.addRow(label,self.color_buttons[key])
        f.addRow('Density',self.density);f.addRow('Sidebar width',self.sidebar);f.addRow('Font scale',self.scale);f.addRow('Effects',self.effects);f.addRow(apply);return w
    def choose_color(self,key,default):
        current=self.color_buttons[key].text();c=QColorDialog.getColor(QColor(current if current.startswith('#') else default),self)
        if c.isValid():self.color_buttons[key].setText(c.name())
    def apply_appearance(self):
        data={'preset':self.preset.currentText(),'density':self.density.currentText(),'sidebar':self.sidebar.currentText(),'font_scale':float(self.scale.currentText()),'effects':self.effects.currentText()}
        for key,b in self.color_buttons.items():data[key]=b.text() if b.text().startswith('#') else ''
        self.core.appearance.save(data);QApplication.instance().setStyleSheet(self.core.appearance.qss());QMessageBox.information(self,'Appearance','Theme applied. Sidebar width changes take effect after restart.')
