        r=self.mcp.currentRow();
        if r<0 or not self.allow_plugins():return
        name=self.mcp.item(r,0).text();ok,msg=self.core.plugins.start_mcp(name);QMessageBox.information(self,'MCP',msg);self.refresh()

class SecurityPage(QWidget):
