class NotificationsPage(QWidget):
    def __init__(self,core):
        super().__init__();self.core=core;lay=QVBoxLayout(self);lay.addWidget(SectionHeader('Notification Center','AEGIS results, workflow runs, pairing alerts, provider issues and system events in one timeline.'));refresh=QPushButton('Refresh');refresh.clicked.connect(self.refresh);lay.addWidget(refresh,0,Qt.AlignLeft);self.list=QListWidget();lay.addWidget(self.list,1);self.timer=QTimer(self);self.timer.timeout.connect(self.refresh);self.timer.start(3000);self.refresh()
    def refresh(self):
        self.list.clear()
        for n in self.core.notifications.recent(200):self.list.addItem(f"{time.strftime('%m-%d %H:%M',time.localtime(n['created_at']))}   {n['source']}   {n['title']}\n{n['body']}")

