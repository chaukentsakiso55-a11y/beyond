        for m in c.get('messages',[]):
            who='YOU' if m['role']=='user' else (m.get('provider') or 'AEGIS');color='#46e6ff' if m['role']=='user' else '#a477ff';body=(m.get('content') or '').replace('&','&amp;').replace('<','&lt;').replace('>','&gt;').replace('\n','<br>');html.append(f"<div style='margin:8px 0;padding:12px;border:1px solid #18344e;border-radius:12px'><b style='color:{color}'>{who}</b><br>{body}</div>")
        self.transcript.setHtml(''.join(html) or '<span style="color:#7896aa">Start a new Infinity conversation.</span>');self.transcript.verticalScrollBar().setValue(self.transcript.verticalScrollBar().maximum())
    def attach_files(self):
        paths,_=QFileDialog.getOpenFileNames(self,'Attach files');
        for p in paths:
            if Path(p).stat().st_size<=20*1024*1024:self.pending.append(self.core.attachments.import_file(p,self.chat_id))
        self.attach_label.setText(', '.join(x['name'] for x in self.pending) or 'No attachments')
